{
  "name": "zet-scraper",
  "version": "1.0.0",
  "description": "Production-grade ZET GTFS-Realtime vehicle position collector and Parquet pipeline",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "validate": "bun run scripts/validate.ts",
    "backfill": "bun run scripts/backfill.ts",
    "export": "bun run scripts/export.ts",
    "predict": "bun run scripts/predict_vehicle.ts",
    "prediction-logger": "bun run scripts/prediction_logger.ts",
    "prediction-analysis": "bun run scripts/prediction_analysis.ts",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "duckdb": "^1.4.4",
    "gtfs-realtime-bindings": "^2.2.0"
  }
}
